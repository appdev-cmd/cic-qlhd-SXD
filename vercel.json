{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{ai/app/**,01_phap_ly_quy_chuan/*.md,ai/evaluation/legal_retrieval.json}",
      "excludeFiles": "{ai/.deps/**,.appraisal-data/**,public/**,output/**,tests/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [
    { "source": "/api/appraisal/:path*", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
