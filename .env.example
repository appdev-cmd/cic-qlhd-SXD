# SUPABASE BACKEND CONFIGURATION
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# DATABASE CONNECTION (FOR POOLER / PRISMA / MIGRATIONS)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# GOOGLE MAPS API KEY
VITE_GOOGLE_MAPS_API_KEY=

# APPRAISAL SERVICES (local demo by default; no cloud writes)
APPRAISAL_MODE=demo
# Fixed Web/Core/Worker ports are defined once in config/runtime-ports.json.
# Set cloud only after applying migrations and assigning Auth profiles.
# APPRAISAL_MODE=cloud
APPRAISAL_ENVIRONMENT=demo
# Dedicated test identities: staging + loopback only. Keep disabled in production.
APPRAISAL_ENABLE_TEST_LOGIN=false
# APPRAISAL_TEST_ACCOUNTS_FILE=C:/private/buildappraisal/test-accounts.json
# Server configuration is loaded from ~/.config/buildappraisal/runtime.env by default.
# APPRAISAL_CONFIG_FILE=C:/private/buildappraisal/runtime.env
# APPRAISAL_DATABASE_URL=postgresql://appraisal_backend.[project-ref]:[password]@[pooler-host]:6543/postgres
# APPRAISAL_DATABASE_CA=C:/private/buildappraisal/supabase-ca.crt
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-key
# APPRAISAL_PYTHON=C:/path/to/python.exe
# APPRAISAL_FONT_DIR=C:/Windows/Fonts
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=C:/private/buildappraisal/tessdata
# Requires official vie.traineddata and eng.traineddata; OCR jobs use a private local spool.
# APPRAISAL_OCR_SPOOL=C:/private/buildappraisal/ocr-spool
# APPRAISAL_ORIGIN=https://your-internal-domain.example
# These are server-only. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=
# Select vertex or openai. Credential files must remain outside the repository.
AI_PROVIDER=openai
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
VERTEX_SA_KEY_PATH=
