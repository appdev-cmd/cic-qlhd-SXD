{
  "name": "build-appraisal-ai",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:ui": "node scripts/ui-rules-lint.cjs",
    "test": "turbo test",
    "db:generate": "pnpm --filter @ba/core prisma:generate",
    "db:push": "pnpm --filter @ba/core prisma:push",
    "db:seed": "pnpm --filter @ba/core prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
