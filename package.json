{
  "name": "cic-thamdinh-sxd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-bim-assets.mjs && node scripts/appraisal.mjs dev",
    "dev:web": "node scripts/prepare-bim-assets.mjs && vite",
    "build": "node scripts/prepare-bim-assets.mjs && tsc -b && vite build",
    "build:vercel": "node scripts/prepare-bim-assets.mjs && tsc -b && vite build && node vercel-build.mjs",
    "preview": "vite preview",
    "dev:appraisal": "node scripts/prepare-bim-assets.mjs && node scripts/appraisal.mjs dev",
    "setup:appraisal": "node scripts/appraisal.mjs setup",
    "samples:build": "node scripts/appraisal.mjs samples",
    "samples:projects": "node scripts/appraisal.mjs seed",
    "test:appraisal": "node scripts/appraisal.mjs test",
    "lint:ui": "node scripts/lint-ui.mjs",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "check:runtime": "node scripts/check_runtime.mjs",
    "api:types": "python scripts/export_openapi.py && npx -y openapi-typescript@7 docs/api/openapi.json --default-non-nullable false -o src/types/api.gen.ts",
    "format": "npx -y prettier@3.6.2 --write \"src/**/*.{ts,tsx}\" \"services/**/*.ts\" \"scripts/*.{mjs,ts}\"",
    "format:check": "npx -y prettier@3.6.2 --check \"src/**/*.{ts,tsx}\" \"services/**/*.ts\" \"scripts/*.{mjs,ts}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rules:check": "node scripts/sync-rules.mjs --check",
    "benchmark:http": "python scripts/benchmark_http.py",
    "test:web": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:backend:node": "node --import tsx --test \"services/appraisal/**/*.test.ts\"",
    "test:e2e": "cd tests/e2e && npx playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "5.105.0",
    "@thatopen/components": "3.4.9",
    "@thatopen/components-front": "3.4.5",
    "@thatopen/fragments": "3.4.8",
    "@types/leaflet": "^1.9.22",
    "ajv": "^8.20.0",
    "camera-controls": "3.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx": "9.9.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "google-auth-library": "^11.3.1",
    "jszip": "3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.24.0",
    "papaparse": "5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.9",
    "tus-js-client": "4.3.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/papaparse": "5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "esbuild": "0.25.12",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
